{
	"name": "@evnt/convert",
	"version": "0.1.3",
	"description": "Convert events between different formats",
	"keywords": [
		"activitystreams",
		"convert",
		"event",
		"google",
		"h-event",
		"icalendar",
		"jcal",
		"jscalendar",
		"microformats",
		"open evnt",
		"schema-org"
	],
	"license": "MIT",
	"author": "Open Evnt Contributors",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./icalendar": "./src/formats/icalendar.ts",
		"./activitystreams": "./src/formats/activitystreams.ts",
		"./schema-org": "./src/formats/schema-org.ts",
		"./google": "./src/formats/google.ts",
		"./community-lexicon": "./src/formats/community-lexicon.ts",
		"./h-event": "./src/formats/h-event.ts",
		"./jscalendar": "./src/formats/jscalendar.ts",
		"./jcal": "./src/formats/jcal.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./icalendar": {
				"types": "./dist/formats/icalendar.d.ts",
				"import": "./dist/formats/icalendar.js",
				"default": "./dist/formats/icalendar.js"
			},
			"./activitystreams": {
				"types": "./dist/formats/activitystreams.d.ts",
				"import": "./dist/formats/activitystreams.js",
				"default": "./dist/formats/activitystreams.js"
			},
			"./schema-org": {
				"types": "./dist/formats/schema-org.d.ts",
				"import": "./dist/formats/schema-org.js",
				"default": "./dist/formats/schema-org.js"
			},
			"./google": {
				"types": "./dist/formats/google.d.ts",
				"import": "./dist/formats/google.js",
				"default": "./dist/formats/google.js"
			},
			"./community-lexicon": {
				"types": "./dist/formats/community-lexicon.d.ts",
				"import": "./dist/formats/community-lexicon.js",
				"default": "./dist/formats/community-lexicon.js"
			},
			"./h-event": {
				"types": "./dist/formats/h-event.d.ts",
				"import": "./dist/formats/h-event.js",
				"default": "./dist/formats/h-event.js"
			},
			"./jscalendar": {
				"types": "./dist/formats/jscalendar.d.ts",
				"import": "./dist/formats/jscalendar.js",
				"default": "./dist/formats/jscalendar.js"
			},
			"./jcal": {
				"types": "./dist/formats/jcal.d.ts",
				"import": "./dist/formats/jcal.js",
				"default": "./dist/formats/jcal.js"
			}
		}
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@evnt/builder": "workspace:^",
		"@evnt/partial-date": "workspace:^",
		"@evnt/schema": "workspace:^",
		"@evnt/translations": "workspace:^",
		"@evnt/types": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "^2.8.1",
		"@atcute/lexicons": "^1.3.0",
		"@repo/typescript-config": "workspace:^",
		"@types/node": "^25.6.0",
		"domhandler": "^6.0.1",
		"temporal-polyfill-lite": "^0.2.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"domhandler": "^6.0.0",
		"htmlparser2": "^12.0.0",
		"ical.js": "^2.2.1"
	},
	"peerDependenciesMeta": {
		"ical.js": {
			"optional": true
		},
		"htmlparser2": {
			"optional": true
		},
		"domhandler": {
			"optional": true
		}
	}
}
