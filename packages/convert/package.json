{
	"name": "@evnt/convert",
	"version": "0.1.1",
	"description": "Open Evnt utilities for converting between different event formats",
	"keywords": [
		"activitystreams",
		"convert",
		"event",
		"google",
		"icalendar",
		"open evnt",
		"schema-org"
	],
	"license": "MIT",
	"author": "Open Evnt Contributors",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./icalendar": "./src/formats/icalendar.ts",
		"./activitystreams": "./src/formats/activitystreams.ts",
		"./schema-org": "./src/formats/schema-org.ts",
		"./google": "./src/formats/google.ts",
		"./community-lexicon": "./src/formats/community-lexicon.ts"
	},
	"publishConfig": {
		"types": "./dist/index.d.ts",
		"exports": {
			".": "./dist/index.js",
			"./icalendar": "./dist/formats/icalendar.js",
			"./activitystreams": "./dist/formats/activitystreams.js",
			"./schema-org": "./dist/formats/schema-org.js",
			"./google": "./dist/formats/google.js",
			"./community-lexicon": "./dist/formats/community-lexicon.js"
		}
	},
	"scripts": {
		"build": "tsc"
	},
	"dependencies": {
		"@evnt/builder": "workspace:^",
		"@evnt/partial-date": "workspace:^",
		"@evnt/schema": "workspace:^",
		"@evnt/translations": "workspace:^",
		"@evnt/types": "workspace:^",
		"ical.js": "^2.2.1",
		"schema-dts": "^1.1.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@atcute/lex-cli": "^2.8.1",
		"@atcute/lexicons": "^1.3.0",
		"@repo/typescript-config": "workspace:^",
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"googleapis": "^171.4.0"
	}
}
