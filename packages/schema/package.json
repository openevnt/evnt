{
	"name": "@evnt/schema",
	"version": "0.1.1",
	"description": "Zod Schemas for OpenEvnt",
	"keywords": [
		"event",
		"open evnt",
		"schema",
		"zod"
	],
	"homepage": "https://evnt.directory",
	"license": "MIT",
	"author": "Open Evnt Contributors",
	"repository": {
		"type": "git",
		"url": "https://github.com/openevnt/evnt.git",
		"directory": "packages/schema"
	},
	"files": [
		"/dist"
	],
	"type": "module",
	"main": "./dist/index.js",
