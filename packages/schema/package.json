	},
	"scripts": {
		"build": "tsc"
	},
	"dependencies": {
		"@evnt/partial-date": "workspace:^",
		"@evnt/translations": "workspace:^",
		"@evnt/types": "workspace:^"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:^",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"zod": "^4"
	}
}
