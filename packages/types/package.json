{
  "name": "@evnt/types",
  "version": "0.1.0",
  "description": "Types for OpenEvnt",
  "keywords": [],
  "homepage": "https://evnt.directory",
  "author": "OpenEvnt",
  "repository": {
    "type": "git",
    "url": "https://github.com/openevnt/evnt.git",
    "directory": "packages/types"
  },
  "files": [
    "/dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./atcute": {
      "import": "./src/atcute.js",
      "types": "./src/atcute.d.ts"
    }
  },
  "publishConfig": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./atcute": {
      "import": "./dist/atcute.js",
      "types": "./dist/atcute.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir=dist"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:^",
    "ts-add-js-extension": "^1.6.6",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@atcute/lexicons": "^2.0.2"
  }
}
