{
	"name": "@evnt/types",
	"version": "0.1.1",
	"description": "Open Evnt Types for TypeScript",
	"keywords": [
		"event",
		"open evnt",
		"types",
		"typescript"
	],
	"homepage": "https://evnt.directory",
	"license": "MIT",
	"author": "Open Evnt Contributors",
	"repository": {
		"type": "git",
		"url": "https://github.com/openevnt/evnt.git",
		"directory": "packages/types"
	},
	"files": [
		"/dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index",
		"./atcute": "./src/atcute"
	},
	"publishConfig": {
		"exports": {
			".": {
				"import": "./dist/index.js",
				"types": "./dist/index.d.ts"
			},
			"./atcute": {
				"import": "./dist/atcute.js",
				"types": "./dist/atcute.d.ts"
			}
		}
	},
	"scripts": {
		"build": "tsc && ts-add-js-extension --dir=dist"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:^",
		"ts-add-js-extension": "^1.6.6",
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"@atcute/lexicons": "^2.0.2"
	}
}
