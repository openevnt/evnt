{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://evnt.directory/openevnt.schema.json",
	"title": "Open Evnt Document",
	"description": "One event in the Open Evnt 0.2 format",
	"type": "object",
	"required": ["v", "id", "name"],
	"properties": {
		"v": { "const": "0.2" },
		"id": {
			"description": "Identifies the event. It never changes and is never reused for another event",
			"$ref": "#/$defs/AbsoluteUri"
		},
		"name": {
			"description": "The event's name as its organizer uses it, including any year or edition",
			"$ref": "#/$defs/Translations"
		},
		"status": {
			"description": "Only present when the event may not take place as listed",
			"enum": ["uncertain", "cancelled", "postponed"]
		},
		"venue": { "$ref": "#/$defs/Venue" },
		"occurrences": {
			"description": "The times the event takes place",
			"type": "array",
			"items": { "$ref": "#/$defs/Occurrence" }
		},
		"components": { "$ref": "#/$defs/Components" }
	},
	"additionalProperties": false,
	"$defs": {
		"Translations": {
			"description": "Text in one or more languages, keyed by BCP 47 language tag",
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/$defs/LanguageTag" },
			"additionalProperties": { "type": "string", "minLength": 1 }
		},
		"LanguageTag": {
			"type": "string",
			"pattern": "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"
		},
		"PartialDate": {
			"description": "A date known to a year, month, day or minute, with an IANA timezone, such as 2026-06-15T09:00[Europe/Vilnius]",
			"type": "string",
			"pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01])(T([01][0-9]|2[0-3]):[0-5][0-9])?)?)?\\[[A-Za-z0-9_/+-]+\\]$",
			"not": { "pattern": "^[0-9]{4}-(02-3[01]|(0[469]|11)-31)" },
			"if": { "pattern": "^[0-9]{4}-02-29" },
			"then": {
				"pattern": "^([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29"
			}
		},
		"AbsoluteUri": {
			"type": "string",
			"format": "uri",
			"pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
		},
		"Venue": {
			"description": "The physical place where every occurrence of the event takes place",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"name": { "$ref": "#/$defs/Translations" },
				"address": {
					"description": "The address as people would write it, or just the city or area when that is all that is known",
					"type": "string"
				},
				"countryCode": {
					"description": "Uppercase ISO 3166-1 alpha-2 code",
					"type": "string",
					"pattern": "^[A-Z]{2}$"
				},
				"components": {
					"$ref": "#/$defs/Components",
					"type": "array",
					"contains": {
						"type": "object",
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.coordinates" } }
					},
					"minContains": 0,
					"maxContains": 1
				}
			},
			"additionalProperties": false
		},
		"Occurrence": {
			"description": "One time the event takes place",
			"type": "object",
			"properties": {
				"start": { "$ref": "#/$defs/PartialDate" },
				"end": { "$ref": "#/$defs/PartialDate" },
				"status": { "const": "cancelled" },
				"activities": {
					"type": "array",
					"items": { "$ref": "#/$defs/Activity" }
				},
				"components": { "$ref": "#/$defs/Components" }
			},
			"additionalProperties": false
		},
		"Activity": {
			"type": "object",
			"required": ["name"],
			"properties": {
				"name": { "$ref": "#/$defs/Translations" },
				"status": { "const": "cancelled" }
			},
			"additionalProperties": false
		},
		"Components": {
			"type": "array",
			"items": { "$ref": "#/$defs/Component" }
		},
		"Component": {
			"type": "object",
			"required": ["$type"],
			"properties": {
				"$type": {
					"description": "Reverse domain name, plus #N for version 1 and later",
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+(#[1-9][0-9]*)?$"
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.richtext.markdown" } }
					},
					"then": { "$ref": "#/$defs/MarkdownComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.link" } }
					},
					"then": { "$ref": "#/$defs/LinkComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.source" } }
					},
					"then": { "$ref": "#/$defs/SourceComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.splashMedia" } }
					},
					"then": { "$ref": "#/$defs/SplashMediaComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.languages" } }
					},
					"then": { "$ref": "#/$defs/LanguagesComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.online" } }
					},
					"then": { "$ref": "#/$defs/OnlineComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.placeId" } }
					},
					"then": { "$ref": "#/$defs/PlaceIdComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.relation" } }
					},
					"then": { "$ref": "#/$defs/RelationComponent" }
				},
				{
					"if": {
						"required": ["$type"],
						"properties": { "$type": { "const": "directory.evnt.component.coordinates" } }
					},
					"then": { "$ref": "#/$defs/CoordinatesComponent" }
				}
			]
		},
		"MarkdownComponent": {
			"type": "object",
			"required": ["$type", "content"],
			"properties": {
				"$type": { "const": "directory.evnt.richtext.markdown" },
				"content": { "type": "string" },
				"language": { "$ref": "#/$defs/LanguageTag" },
				"flavor": {
					"description": "The Markdown flavor, such as commonmark or gfm",
					"type": "string"
				}
			}
		},
		"LinkComponent": {
			"type": "object",
			"required": ["$type", "url"],
			"properties": {
				"$type": { "const": "directory.evnt.component.link" },
				"url": { "$ref": "#/$defs/AbsoluteUri" },
				"name": { "$ref": "#/$defs/Translations" },
				"disabled": {
					"description": "The link is unavailable for now",
					"type": "boolean"
				}
			}
		},
		"SourceComponent": {
			"type": "object",
			"required": ["$type", "url"],
			"properties": {
				"$type": { "const": "directory.evnt.component.source" },
				"url": { "$ref": "#/$defs/AbsoluteUri" }
			}
		},
		"SplashMediaComponent": {
			"type": "object",
			"required": ["$type", "media"],
			"properties": {
				"$type": { "const": "directory.evnt.component.splashMedia" },
				"media": { "$ref": "#/$defs/Media" },
				"roles": {
					"description": "Where the media is meant to be shown: background, poster, banner, or the producer's own value",
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"Media": {
			"type": "object",
			"required": ["sources"],
			"properties": {
				"sources": {
					"description": "The same image or video in one or more formats or resolutions",
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/MediaSource" }
				},
				"alt": { "$ref": "#/$defs/Translations" },
				"presentation": {
					"type": "object",
					"properties": {
						"blurhash": { "type": "string" },
						"dominantColor": {
							"type": "string",
							"pattern": "^#[0-9A-Fa-f]{6}$"
						}
					}
				}
			}
		},
		"MediaSource": {
			"type": "object",
			"required": ["url"],
			"properties": {
				"url": { "$ref": "#/$defs/AbsoluteUri" },
				"mimeType": { "type": "string" },
				"dimensions": {
					"description": "Width and height in pixels",
					"type": "object",
					"required": ["width", "height"],
					"properties": {
						"width": { "type": "number" },
						"height": { "type": "number" }
					}
				}
			}
		},
		"LanguagesComponent": {
			"type": "object",
			"required": ["$type", "languages"],
			"properties": {
				"$type": { "const": "directory.evnt.component.languages" },
				"languages": {
					"description": "The languages the event is held in, not the languages of the document",
					"type": "array",
					"items": {
						"type": "object",
						"required": ["code"],
						"properties": {
							"code": { "$ref": "#/$defs/LanguageTag" }
						}
					}
				}
			}
		},
		"OnlineComponent": {
			"type": "object",
			"required": ["$type", "url"],
			"properties": {
				"$type": { "const": "directory.evnt.component.online" },
				"url": { "$ref": "#/$defs/AbsoluteUri" },
				"name": { "$ref": "#/$defs/Translations" }
			}
		},
		"PlaceIdComponent": {
			"type": "object",
			"required": ["$type", "type", "id"],
			"properties": {
				"$type": { "const": "directory.evnt.component.placeId" },
				"type": {
					"description": "The service and kind of entry, such as org.openstreetmap.way",
					"type": "string"
				},
				"id": { "type": "string" }
			}
		},
		"RelationComponent": {
			"type": "object",
			"required": ["$type", "type", "target"],
			"properties": {
				"$type": { "const": "directory.evnt.component.relation" },
				"type": {
					"description": "parent, child, alternate, or the producer's own value in reverse domain name notation",
					"type": "string"
				},
				"target": {
					"description": "Usually the id of the other event",
					"$ref": "#/$defs/AbsoluteUri"
				}
			}
		},
		"CoordinatesComponent": {
			"type": "object",
			"required": ["$type", "latitude", "longitude"],
			"properties": {
				"$type": { "const": "directory.evnt.component.coordinates" },
				"latitude": { "type": "number", "minimum": -90, "maximum": 90 },
				"longitude": { "type": "number", "minimum": -180, "maximum": 180 },
				"uncertainty": {
					"description": "How far the venue may be from the point, in metres",
					"type": "number",
					"exclusiveMinimum": 0
				}
			}
		}
	}
}
